trap "postfix stop" SIGINT
trap "postfix stop" SIGTERM
trap "postfix reload" SIGHUP

copy_if_needed() {
  src="$1"
  dst="$2"

  if [ -e "$dst" ] && [ "$(readlink -f "$src")" = "$(readlink -f "$dst")" ]; then
    return 0
  fi

  cp "$src" "$dst"
}

# ensure postfix queue directories exist and are writable
mkdir -p /var/spool/postfix/etc

# refresh chroot network files before postfix check/start
copy_if_needed /etc/hosts /var/spool/postfix/etc/hosts
copy_if_needed /etc/resolv.conf /var/spool/postfix/etc/resolv.conf

# attempt to create any missing queue directories
if ! postfix check >/dev/null 2>&1; then
  mkdir -p \
    /var/spool/postfix/active \
    /var/spool/postfix/bounce \
    /var/spool/postfix/corrupt \
    /var/spool/postfix/defer \
    /var/spool/postfix/deferred \
    /var/spool/postfix/flush \
    /var/spool/postfix/hold \
    /var/spool/postfix/incoming \
    /var/spool/postfix/maildrop \
    /var/spool/postfix/saved \
    /var/spool/postfix/private \
    /var/spool/postfix/public \
    /var/spool/postfix/pid
fi

# (re)build postfix maps so *.db files always exist
postmap /etc/postfix/sasl_passwd 2>/dev/null || true
postmap /etc/postfix/generic 2>/dev/null || true
postmap /etc/postfix/relayhost_map 2>/dev/null || true
newaliases 2>/dev/null || true

# fix ownership/mode for queue tree after fallback creation
postfix set-permissions 2>/dev/null || true

# start postfix
postfix start || exit 1

# lets give postfix some time to start
sleep 3

pid_file=/var/spool/postfix/pid/master.pid
if [ ! -s "$pid_file" ]; then
  echo "Postfix startup failed: missing $pid_file"
  postfix status || true
  exit 1
fi

# wait until postfix is dead (triggered by trap)
while kill -0 "$(cat "$pid_file")" 2>/dev/null; do
  sleep 5
done
